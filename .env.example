# Copy to .env and change the secrets. .env is git-ignored.
POSTGRES_USER=arcline
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=arcline

MONGO_USER=arcline
MONGO_PASSWORD=change-me-mongo
MONGO_DB=arcline

# Long random strings, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-jwt-secret
INTERNAL_TOKEN=change-me-internal-token

JWT_TTL_HOURS=12
PRESENCE_TIMEOUT_S=30
READY_TIMEOUT_S=45

FRONTEND_PORT=8080
GATEWAY_PORT=8000
POSTGRES_PORT=5432
MONGO_PORT=27017
