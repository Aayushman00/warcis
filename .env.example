# Copy to .env and change the secrets. .env is git-ignored.
POSTGRES_USER=warcis
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=warcis

MONGO_USER=warcis
MONGO_PASSWORD=change-me-mongo
MONGO_DB=warcis

# Long random strings, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-jwt-secret
INTERNAL_TOKEN=change-me-internal-token

JWT_TTL_HOURS=12
PRESENCE_TIMEOUT_S=30
READY_TIMEOUT_S=60

FRONTEND_PORT=8080
GATEWAY_PORT=8000
POSTGRES_PORT=5432
MONGO_PORT=27017

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Public hostname -> http://frontend:80
CLOUDFLARE_TUNNEL_TOKEN=
